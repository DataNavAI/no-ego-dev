# NoEgoDev / NED environment example
# Copy this file to .env in your installed profile and fill in real values.
# Do not commit .env.

# Minimum: set at least one model provider key.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Optional: useful when NED needs to create repos, open PRs, check CI, or publish releases.
GITHUB_TOKEN=ghp_your-github-token-here

# Optional: browser automation through an existing Chrome DevTools session.
# Leave blank unless you know you need it.
BROWSER_CDP_URL=http://127.0.0.1:9222

# Optional: deployment/publishing provider tokens go here as needed by your project.
# VERCEL_TOKEN=your-vercel-token-here
# NETLIFY_AUTH_TOKEN=your-netlify-token-here
# CLOUDFLARE_API_TOKEN=your-cloudflare-token-here
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/local/service-account.json
