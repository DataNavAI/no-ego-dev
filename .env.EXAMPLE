# NoEgoDev / NED environment example
# Do not commit a populated .env.

# Daytona is the only v1 compute provider. Prefer an OS secret store or hidden TTY
# input; use environment injection only for an already-authorized headless run.
DAYTONA_API_KEY=<store-backed-secret>

# OpenRouter PKCE is the default interactive v1 model authorization path.
# This variable is only for an already-authorized headless/automation credential.
OPENROUTER_API_KEY=<store-backed-secret>

# Optional: useful when NED needs to create repos, open PRs, check CI, or publish releases.
GITHUB_TOKEN=ghp_your-github-token-here

# Optional deployment/publishing credentials belong in a local secret store as needed.
# VERCEL_TOKEN=<store-backed-secret>
# NETLIFY_AUTH_TOKEN=<store-backed-secret>
# CLOUDFLARE_API_TOKEN=<store-backed-secret>
