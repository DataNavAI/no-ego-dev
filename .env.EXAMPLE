# NoEgoDev / NED environment example
# Copy this file to .env in your installed profile and fill in real values.
# Do not commit .env.

# Minimum: configure one model provider through secure environment/secret-store injection.
# OpenRouter remains the backwards-compatible CLI default; browser onboarding is provider-neutral.
OPENAI_API_KEY=<store-backed-secret>
ANTHROPIC_API_KEY=<store-backed-secret>
GEMINI_API_KEY=<store-backed-secret>
# GOOGLE_API_KEY=<store-backed-secret>
OPENROUTER_API_KEY=<store-backed-secret>

# Optional: useful when NED needs to create repos, open PRs, check CI, or publish releases.
GITHUB_TOKEN=ghp_your-github-token-here

# Optional: browser automation through an existing Chrome DevTools session.
# Leave blank unless you know you need it.
BROWSER_CDP_URL=http://127.0.0.1:9222

# Optional: deployment/publishing provider tokens go here as needed by your project.
# VERCEL_TOKEN=your-vercel-token-here
# NETLIFY_AUTH_TOKEN=your-netlify-token-here
# CLOUDFLARE_API_TOKEN=your-cloudflare-token-here
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/local/service-account.json

# `ned create` AWS staging runtime. CloudFormation supplies these non-secret values;
# DAYTONA_API_KEY is injected directly from Secrets Manager and must not be put in this file.
# NED_STAGE=staging
# NED_PUBLIC_ORIGIN=https://example.awsapprunner.com
# NED_COGNITO_USER_POOL_ID=us-east-1_example
# NED_COGNITO_CLIENT_ID=example
# NED_LIFECYCLE_TABLE=noegodev-ned-staging-lifecycle
# NED_SECRET_PREFIX=noegodev-ned-staging/model
# NED_KMS_KEY_ARN=arn:aws:kms:us-east-1:061039762362:key/example
# NED_SWEEP_INTERVAL_MS=60000
# NED_MAX_ACTIVE_SESSIONS=10
# NED_MAX_JOBS_PER_DAY=20
# NED_METRIC_NAMESPACE=NoEgoDev/NedCreateStaging
# NED_DAYTONA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:061039762362:secret:noegodev-ned-staging/daytona
# NED_ALLOWED_MODEL_PROVIDERS=openai,anthropic,gemini
# DEPLOYMENT_REVISION=<40-character-committed-source-sha>
